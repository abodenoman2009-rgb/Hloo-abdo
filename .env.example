# ============================================================================
# Wusul (وصل) - Environment Variables Reference
# ============================================================================

# APP_URL (Public / Server & Client):
# Service: Hosting / App Runtime (AI Studio Cloud Run, Railway, Render)
# Purpose: Canonical public URL for shareable call links and CORS origin checks.
# How to obtain: Provided automatically by AI Studio or your hosting provider.
APP_URL=

# ALLOWED_ORIGINS (Server-side):
# Service: Express / WebSocket Origin Guard
# Purpose: Comma-separated list of trusted origins (in addition to APP_URL).
# How to obtain: Set to your production domain(s) (e.g. https://call.example.com).
ALLOWED_ORIGINS=

# STUN_SERVER_URL (Public / Server-served to WebRTC):
# Service: WebRTC ICE STUN Server
# Purpose: NAT public IP discovery for peer-to-peer media connections.
# How to obtain: Public STUN (default: stun:stun.l.google.com:19302) or Coturn.
STUN_SERVER_URL=stun:stun.l.google.com:19302

# TURN_SERVER_URL (Server-side -> served dynamically to authenticated clients):
# Service: Coturn / Metered.ca / Twilio Network Traversal TURN Server
# Purpose: Relays audio/video when symmetric NATs or mobile carrier firewalls block P2P.
# How to obtain: Deploy Coturn or create free/paid TURN credentials on Metered.ca or Twilio.
TURN_SERVER_URL=

# TURN_USERNAME (Secret / Server-side):
# Service: TURN Server Authentication
# Purpose: Username for authenticating WebRTC ICE relay allocations.
# How to obtain: Generated in your TURN provider dashboard or Coturn config.
TURN_USERNAME=

# TURN_PASSWORD (Secret / Server-side):
# Service: TURN Server Authentication
# Purpose: Credential for authenticating WebRTC ICE relay allocations.
# How to obtain: Generated in your TURN provider dashboard or Coturn config.
TURN_PASSWORD=

# RATE_LIMIT_WINDOW_MS (Server-side):
# Service: Express API Rate Limiter
# Purpose: Time window in milliseconds (default: 60000).
RATE_LIMIT_WINDOW_MS=60000

# RATE_LIMIT_MAX_REQUESTS (Server-side):
# Service: Express API Rate Limiter
# Purpose: Max requests per IP per window (default: 120).
RATE_LIMIT_MAX_REQUESTS=120
