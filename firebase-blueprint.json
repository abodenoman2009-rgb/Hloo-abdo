{
  "entities": {
    "UserPrivate": {
      "title": "UserPrivate",
      "description": "Private user account record containing PII such as email and preferences",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 254
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "photoURL": {
          "type": "string",
          "maxLength": 512
        },
        "preferredLanguage": {
          "type": "string",
          "enum": ["ar", "en"]
        },
        "preferredTheme": {
          "type": "string",
          "enum": ["light", "dark"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "uid",
        "email",
        "displayName",
        "photoURL",
        "preferredLanguage",
        "preferredTheme",
        "createdAt",
        "updatedAt"
      ]
    },
    "PublicProfile": {
      "title": "PublicProfile",
      "description": "Discoverable non-PII user profile for search and presence",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "handle": {
          "type": "string",
          "minLength": 2,
          "maxLength": 40,
          "pattern": "^[a-zA-Z0-9_.\\-]+$"
        },
        "bio": {
          "type": "string",
          "maxLength": 200
        },
        "photoURL": {
          "type": "string",
          "maxLength": 512
        },
        "presence": {
          "type": "string",
          "enum": ["online", "in-call", "busy", "offline"]
        },
        "isDiscoverable": {
          "type": "boolean"
        },
        "lastSeen": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "uid",
        "displayName",
        "handle",
        "bio",
        "photoURL",
        "presence",
        "isDiscoverable",
        "lastSeen",
        "updatedAt"
      ]
    },
    "Friendship": {
      "title": "Friendship",
      "description": "Confirmed bidirectional friend connection between two users",
      "type": "object",
      "properties": {
        "userA": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userB": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userAName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "userBName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "userAPhoto": {
          "type": "string",
          "maxLength": 512
        },
        "userBPhoto": {
          "type": "string",
          "maxLength": 512
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "userA",
        "userB",
        "userAName",
        "userBName",
        "userAPhoto",
        "userBPhoto",
        "createdAt"
      ]
    },
    "FriendRequest": {
      "title": "FriendRequest",
      "description": "Pending, accepted, or rejected friend request",
      "type": "object",
      "properties": {
        "fromUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "toUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "fromName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "fromHandle": {
          "type": "string",
          "minLength": 2,
          "maxLength": 40
        },
        "fromPhoto": {
          "type": "string",
          "maxLength": 512
        },
        "toName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "toHandle": {
          "type": "string",
          "minLength": 2,
          "maxLength": 40
        },
        "toPhoto": {
          "type": "string",
          "maxLength": 512
        },
        "status": {
          "type": "string",
          "enum": ["pending", "accepted", "rejected"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "fromUid",
        "toUid",
        "fromName",
        "fromHandle",
        "fromPhoto",
        "toName",
        "toHandle",
        "toPhoto",
        "status",
        "createdAt",
        "updatedAt"
      ]
    },
    "CallSession": {
      "title": "CallSession",
      "description": "Active or shareable call room metadata",
      "type": "object",
      "properties": {
        "roomCode": {
          "type": "string",
          "minLength": 4,
          "maxLength": 24,
          "pattern": "^[A-Z0-9\\-]+$"
        },
        "hostUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "hostName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "callType": {
          "type": "string",
          "enum": ["video", "voice"]
        },
        "status": {
          "type": "string",
          "enum": ["waiting", "ringing", "active", "ended"]
        },
        "isPublicLink": {
          "type": "boolean"
        },
        "invitedUid": {
          "type": "string",
          "maxLength": 128
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "roomCode",
        "hostUid",
        "hostName",
        "callType",
        "status",
        "isPublicLink",
        "invitedUid",
        "createdAt",
        "updatedAt"
      ]
    },
    "CallHistoryEntry": {
      "title": "CallHistoryEntry",
      "description": "Immutable call log entry owned by a user",
      "type": "object",
      "properties": {
        "ownerUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "peerUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "peerName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "peerPhoto": {
          "type": "string",
          "maxLength": 512
        },
        "callType": {
          "type": "string",
          "enum": ["video", "voice"]
        },
        "direction": {
          "type": "string",
          "enum": ["outgoing", "incoming"]
        },
        "status": {
          "type": "string",
          "enum": ["completed", "missed", "rejected", "cancelled"]
        },
        "durationSeconds": {
          "type": "integer"
        },
        "roomCode": {
          "type": "string",
          "maxLength": 24
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerUid",
        "peerUid",
        "peerName",
        "peerPhoto",
        "callType",
        "direction",
        "status",
        "durationSeconds",
        "roomCode",
        "createdAt"
      ]
    },
    "UserNotification": {
      "title": "UserNotification",
      "description": "In-app notification entry for a user",
      "type": "object",
      "properties": {
        "ownerUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "type": {
          "type": "string",
          "enum": ["friend_request", "missed_call", "system"]
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "body": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "read": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerUid",
        "type",
        "title",
        "body",
        "read",
        "createdAt"
      ]
    },
    "UserDevice": {
      "title": "UserDevice",
      "description": "Registered browser or mobile device metadata for user",
      "type": "object",
      "properties": {
        "ownerUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "platform": {
          "type": "string",
          "enum": ["web", "ios", "android"]
        },
        "lastActiveAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerUid",
        "label",
        "platform",
        "lastActiveAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserPrivate" },
      "description": "Private user account PII and personal preferences"
    },
    "/publicProfiles/{userId}": {
      "schema": { "$ref": "#/entities/PublicProfile" },
      "description": "Discoverable non-PII directory profiles"
    },
    "/friendships/{friendshipId}": {
      "schema": { "$ref": "#/entities/Friendship" },
      "description": "Confirmed friend connections"
    },
    "/friendRequests/{requestId}": {
      "schema": { "$ref": "#/entities/FriendRequest" },
      "description": "Friend request lifecycle documents"
    },
    "/calls/{callId}": {
      "schema": { "$ref": "#/entities/CallSession" },
      "description": "Call rooms and direct invite sessions"
    },
    "/users/{userId}/callHistory/{historyId}": {
      "schema": { "$ref": "#/entities/CallHistoryEntry" },
      "description": "User-owned immutable call history log"
    },
    "/users/{userId}/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/UserNotification" },
      "description": "User-owned notifications"
    },
    "/users/{userId}/devices/{deviceId}": {
      "schema": { "$ref": "#/entities/UserDevice" },
      "description": "User-owned registered devices"
    }
  }
}
