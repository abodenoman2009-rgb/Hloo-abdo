rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net: default deny everything
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Global Hardened Primitives ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isVerifiedOwner(userId) {
      return isVerified() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isNonEmptyString(val, maxLen) {
      return val is string && val.size() >= 1 && val.size() <= maxLen;
    }

    function isBoundedString(val, maxLen) {
      return val is string && val.size() <= maxLen;
    }

    // --- Validation Blueprints ---
    function isValidUserPrivate(data) {
      return data.keys().hasAll([
        'uid', 'email', 'displayName', 'photoURL',
        'preferredLanguage', 'preferredTheme', 'createdAt', 'updatedAt'
      ])
      && data.keys().hasOnly([
        'uid', 'email', 'displayName', 'photoURL',
        'preferredLanguage', 'preferredTheme', 'createdAt', 'updatedAt'
      ])
      && isValidId(data.uid)
      && data.uid == request.auth.uid
      && isNonEmptyString(data.email, 254)
      && isNonEmptyString(data.displayName, 80)
      && isBoundedString(data.photoURL, 512)
      && (data.preferredLanguage == 'ar' || data.preferredLanguage == 'en')
      && (data.preferredTheme == 'light' || data.preferredTheme == 'dark')
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    function isValidPublicProfile(data) {
      return data.keys().hasAll([
        'uid', 'displayName', 'handle', 'bio', 'photoURL',
        'presence', 'isDiscoverable', 'lastSeen', 'updatedAt'
      ])
      && data.keys().hasOnly([
        'uid', 'displayName', 'handle', 'bio', 'photoURL',
        'presence', 'isDiscoverable', 'lastSeen', 'updatedAt'
      ])
      && isValidId(data.uid)
      && data.uid == request.auth.uid
      && isNonEmptyString(data.displayName, 80)
      && data.handle is string && data.handle.size() >= 2 && data.handle.size() <= 40
      && data.handle.matches('^[a-zA-Z0-9_.\\-]+$')
      && isBoundedString(data.bio, 200)
      && isBoundedString(data.photoURL, 512)
      && (data.presence == 'online' || data.presence == 'in-call' || data.presence == 'busy' || data.presence == 'offline')
      && data.isDiscoverable is bool
      && data.lastSeen is timestamp
      && data.updatedAt is timestamp;
    }

    function isValidFriendship(data) {
      return data.keys().hasAll([
        'userA', 'userB', 'userAName', 'userBName',
        'userAPhoto', 'userBPhoto', 'createdAt'
      ])
      && data.keys().hasOnly([
        'userA', 'userB', 'userAName', 'userBName',
        'userAPhoto', 'userBPhoto', 'createdAt'
      ])
      && isValidId(data.userA)
      && isValidId(data.userB)
      && data.userA != data.userB
      && (data.userA == request.auth.uid || data.userB == request.auth.uid)
      && isNonEmptyString(data.userAName, 80)
      && isNonEmptyString(data.userBName, 80)
      && isBoundedString(data.userAPhoto, 512)
      && isBoundedString(data.userBPhoto, 512)
      && data.createdAt is timestamp;
    }

    function isValidFriendRequest(data) {
      return data.keys().hasAll([
        'fromUid', 'toUid', 'fromName', 'fromHandle', 'fromPhoto',
        'toName', 'toHandle', 'toPhoto', 'status', 'createdAt', 'updatedAt'
      ])
      && data.keys().hasOnly([
        'fromUid', 'toUid', 'fromName', 'fromHandle', 'fromPhoto',
        'toName', 'toHandle', 'toPhoto', 'status', 'createdAt', 'updatedAt'
      ])
      && isValidId(data.fromUid)
      && isValidId(data.toUid)
      && data.fromUid != data.toUid
      && isNonEmptyString(data.fromName, 80)
      && data.fromHandle is string && data.fromHandle.size() >= 2 && data.fromHandle.size() <= 40
      && isBoundedString(data.fromPhoto, 512)
      && isNonEmptyString(data.toName, 80)
      && data.toHandle is string && data.toHandle.size() >= 2 && data.toHandle.size() <= 40
      && isBoundedString(data.toPhoto, 512)
      && (data.status == 'pending' || data.status == 'accepted' || data.status == 'rejected')
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    function isValidCallSession(data) {
      return data.keys().hasAll([
        'roomCode', 'hostUid', 'hostName', 'callType',
        'status', 'isPublicLink', 'invitedUid', 'createdAt', 'updatedAt'
      ])
      && data.keys().hasOnly([
        'roomCode', 'hostUid', 'hostName', 'callType',
        'status', 'isPublicLink', 'invitedUid', 'createdAt', 'updatedAt'
      ])
      && data.roomCode is string && data.roomCode.size() >= 4 && data.roomCode.size() <= 24
      && data.roomCode.matches('^[A-Z0-9\\-]+$')
      && isValidId(data.hostUid)
      && isNonEmptyString(data.hostName, 80)
      && (data.callType == 'video' || data.callType == 'voice')
      && (data.status == 'waiting' || data.status == 'ringing' || data.status == 'active' || data.status == 'ended')
      && data.isPublicLink is bool
      && isBoundedString(data.invitedUid, 128)
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    function isValidCallHistory(data, userId) {
      return data.keys().hasAll([
        'ownerUid', 'peerUid', 'peerName', 'peerPhoto',
        'callType', 'direction', 'status', 'durationSeconds', 'roomCode', 'createdAt'
      ])
      && data.keys().hasOnly([
        'ownerUid', 'peerUid', 'peerName', 'peerPhoto',
        'callType', 'direction', 'status', 'durationSeconds', 'roomCode', 'createdAt'
      ])
      && isValidId(data.ownerUid)
      && data.ownerUid == userId
      && isNonEmptyString(data.peerUid, 128)
      && isNonEmptyString(data.peerName, 80)
      && isBoundedString(data.peerPhoto, 512)
      && (data.callType == 'video' || data.callType == 'voice')
      && (data.direction == 'outgoing' || data.direction == 'incoming')
      && (data.status == 'completed' || data.status == 'missed' || data.status == 'rejected' || data.status == 'cancelled')
      && data.durationSeconds is int
      && data.durationSeconds >= 0 && data.durationSeconds <= 86400
      && isBoundedString(data.roomCode, 24)
      && data.createdAt is timestamp;
    }

    function isValidNotification(data, userId) {
      return data.keys().hasAll([
        'ownerUid', 'type', 'title', 'body', 'read', 'createdAt'
      ])
      && data.keys().hasOnly([
        'ownerUid', 'type', 'title', 'body', 'read', 'createdAt'
      ])
      && isValidId(data.ownerUid)
      && data.ownerUid == userId
      && (data.type == 'friend_request' || data.type == 'missed_call' || data.type == 'system')
      && isNonEmptyString(data.title, 120)
      && isNonEmptyString(data.body, 300)
      && data.read is bool
      && data.createdAt is timestamp;
    }

    function isValidDevice(data, userId) {
      return data.keys().hasAll([
        'ownerUid', 'label', 'platform', 'lastActiveAt'
      ])
      && data.keys().hasOnly([
        'ownerUid', 'label', 'platform', 'lastActiveAt'
      ])
      && isValidId(data.ownerUid)
      && data.ownerUid == userId
      && isNonEmptyString(data.label, 100)
      && (data.platform == 'web' || data.platform == 'ios' || data.platform == 'android')
      && data.lastActiveAt is timestamp;
    }

    // --- Collection Match Rules ---

    // Connectivity probe document (authenticated read only)
    match /test/{docId} {
      allow get: if isSignedIn() && docId == 'connection';
    }

    // 1. Private User Account PII
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;
      allow create: if isVerifiedOwner(userId)
        && isValidId(userId)
        && isValidUserPrivate(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedOwner(userId)
        && isValidId(userId)
        && isValidUserPrivate(incoming())
        && incoming().uid == existing().uid
        && incoming().email == existing().email
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName', 'photoURL', 'preferredLanguage', 'preferredTheme', 'updatedAt'
        ]);
      allow delete: if isVerifiedOwner(userId) && isValidId(userId);

      // Call History Subcollection
      match /callHistory/{historyId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(historyId);
        allow list: if isOwner(userId) && resource.data.ownerUid == request.auth.uid;
        allow create: if isVerifiedOwner(userId)
          && isValidId(userId)
          && isValidId(historyId)
          && isValidCallHistory(incoming(), userId)
          && incoming().createdAt == request.time;
        allow update: if false;
        allow delete: if isVerifiedOwner(userId) && isValidId(userId) && isValidId(historyId);
      }

      // Notifications Subcollection
      match /notifications/{notificationId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(notificationId);
        allow list: if isOwner(userId) && resource.data.ownerUid == request.auth.uid;
        allow create: if isVerifiedOwner(userId)
          && isValidId(userId)
          && isValidId(notificationId)
          && isValidNotification(incoming(), userId)
          && incoming().createdAt == request.time;
        allow update: if isVerifiedOwner(userId)
          && isValidId(userId)
          && isValidId(notificationId)
          && isValidNotification(incoming(), userId)
          && incoming().ownerUid == existing().ownerUid
          && incoming().createdAt == existing().createdAt
          && incoming().diff(existing()).affectedKeys().hasOnly(['read']);
        allow delete: if isVerifiedOwner(userId) && isValidId(userId) && isValidId(notificationId);
      }

      // Devices Subcollection
      match /devices/{deviceId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(deviceId);
        allow list: if isOwner(userId) && resource.data.ownerUid == request.auth.uid;
        allow create: if isVerifiedOwner(userId)
          && isValidId(userId)
          && isValidId(deviceId)
          && isValidDevice(incoming(), userId)
          && incoming().lastActiveAt == request.time;
        allow update: if isVerifiedOwner(userId)
          && isValidId(userId)
          && isValidId(deviceId)
          && isValidDevice(incoming(), userId)
          && incoming().ownerUid == existing().ownerUid
          && incoming().lastActiveAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['label', 'platform', 'lastActiveAt']);
        allow delete: if isVerifiedOwner(userId) && isValidId(userId) && isValidId(deviceId);
      }
    }

    // 2. Public Non-PII Profiles (for discovery & presence)
    match /publicProfiles/{userId} {
      allow get: if isSignedIn() && isValidId(userId);
      allow list: if isSignedIn() && resource.data.isDiscoverable == true;
      allow create: if isVerifiedOwner(userId)
        && isValidId(userId)
        && isValidPublicProfile(incoming())
        && incoming().lastSeen == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedOwner(userId)
        && isValidId(userId)
        && isValidPublicProfile(incoming())
        && incoming().uid == existing().uid
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName', 'handle', 'bio', 'photoURL',
          'presence', 'isDiscoverable', 'lastSeen', 'updatedAt'
        ]);
      allow delete: if isVerifiedOwner(userId) && isValidId(userId);
    }

    // 3. Friendships
    match /friendships/{friendshipId} {
      allow get: if isSignedIn() && isValidId(friendshipId)
        && (resource.data.userA == request.auth.uid || resource.data.userB == request.auth.uid);
      allow list: if isSignedIn()
        && (resource.data.userA == request.auth.uid || resource.data.userB == request.auth.uid);
      allow create: if isVerified()
        && isValidId(friendshipId)
        && isValidFriendship(incoming())
        && incoming().createdAt == request.time
        && exists(/databases/$(database)/documents/publicProfiles/$(incoming().userA))
        && exists(/databases/$(database)/documents/publicProfiles/$(incoming().userB));
      allow update: if false;
      allow delete: if isVerified() && isValidId(friendshipId)
        && (resource.data.userA == request.auth.uid || resource.data.userB == request.auth.uid);
    }

    // 4. Friend Requests
    match /friendRequests/{requestId} {
      allow get: if isSignedIn() && isValidId(requestId)
        && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
      allow list: if isSignedIn()
        && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
      allow create: if isVerified()
        && isValidId(requestId)
        && isValidFriendRequest(incoming())
        && incoming().fromUid == request.auth.uid
        && incoming().status == 'pending'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && exists(/databases/$(database)/documents/publicProfiles/$(incoming().toUid));
      allow update: if isVerified()
        && isValidId(requestId)
        && isValidFriendRequest(incoming())
        && existing().status == 'pending'
        && resource.data.toUid == request.auth.uid
        && incoming().fromUid == existing().fromUid
        && incoming().toUid == existing().toUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (incoming().status == 'accepted' || incoming().status == 'rejected')
        && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']);
      allow delete: if isVerified() && isValidId(requestId)
        && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
    }

    // 5. Call Rooms & Sessions
    match /calls/{callId} {
      allow get: if isSignedIn() && isValidId(callId)
        && (resource.data.hostUid == request.auth.uid
            || resource.data.invitedUid == request.auth.uid
            || resource.data.isPublicLink == true);
      allow list: if isSignedIn()
        && (resource.data.hostUid == request.auth.uid
            || resource.data.invitedUid == request.auth.uid
            || resource.data.isPublicLink == true);
      allow create: if isVerified()
        && isValidId(callId)
        && isValidCallSession(incoming())
        && incoming().hostUid == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerified()
        && isValidId(callId)
        && isValidCallSession(incoming())
        && existing().status != 'ended'
        && (resource.data.hostUid == request.auth.uid
            || resource.data.invitedUid == request.auth.uid
            || resource.data.isPublicLink == true)
        && incoming().hostUid == existing().hostUid
        && incoming().roomCode == existing().roomCode
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'callType', 'updatedAt']);
      allow delete: if isVerified() && isValidId(callId)
        && resource.data.hostUid == request.auth.uid;
    }
  }
}
